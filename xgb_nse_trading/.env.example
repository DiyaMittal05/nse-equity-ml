# Copy to .env and fill in. Only needed for the Angel One minute-data loader (src/data_loader.py);
# the daily pipeline (main.py) runs on the R CSVs without any keys.
ANGEL_ONE_API_KEY=
ANGEL_ONE_CLIENT_CODE=
ANGEL_ONE_PASSWORD=
# The secret shown when enabling TOTP on Angel One (not the 6-digit code)
ANGEL_ONE_TOTP_SECRET=
