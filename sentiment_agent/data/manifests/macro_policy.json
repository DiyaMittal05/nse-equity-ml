{
  "name": "macro_policy",
  "type": "agent",
  "universe": "both",
  "description": "Classify macro policy headlines and map to affected sectors",
  "capabilities": ["classify_policy", "map_to_sectors", "estimate_magnitude"],
  "entrypoint": "src.agents.macro_policy_agent:run",
  "parameters": {
    "headline": {"type": "string", "required": true}
