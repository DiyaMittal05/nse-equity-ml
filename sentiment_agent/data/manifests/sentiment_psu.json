{
  "name": "sentiment_impact_psu",
  "type": "agent",
  "universe": "psu",
  "description": "Multi-stage sentiment impact scoring for PSU banks",
  "capabilities": ["resolve_tickers", "filter_relevance", "score_impact", "sector_routing"],
  "entrypoint": "src.agents.sentiment_impact_agent:run",
  "parameters": {
    "headline": {"type": "string", "required": true},
    "tickers": {"type": "list[string]", "required": false},
    "macro_context": {"type": "object", "required": false}
  },
  "output_schema": "list[{ticker, sentiment, relevance, sector_beta, impact}]",
  "sub_manifests": ["ohlcv_psu", "indicator_psu"],
  "requires_llm": false
}
